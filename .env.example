# 이 파일을 .env.local 로 복사한 후 본인 값으로 채우세요.
# .env.local 은 .gitignore 됩니다 — 절대 커밋 금지.

# === LLM API 키 ===
OPEN_AI_KEY=sk-...
ANTHROPIC_KEY=
# Cohere Rerank (선택) — 비워두면 NoOp 사용. https://dashboard.cohere.com/api-keys
COHERE_API_KEY=

# === DB ===
DB_URL=r2dbc:postgresql://localhost:5432/postgres
DB_USERNAME=postgres
DB_PASSWORD=

# === Redis ===
REDIS_URL=redis://localhost:6379
REDIS_WRITER_HOST=localhost
REDIS_WRITER_PORT=6379
REDIS_WRITER_PASSWORD=
REDIS_READER_HOST=localhost
REDIS_READER_PORT=6379
REDIS_READER_PASSWORD=

# === OCR ===
PDF_OCR_STRATEGY=AUTO
TESSERACT_LANG=kor+eng

# === Spring ===
SPRING_PROFILES_ACTIVE=local

# === CORS ===
ALLOW_ORIGINS=http://localhost:3000
